diff --git a/services/controller/sandbox_macos.py b/services/controller/sandbox_macos.py
new file mode 100644
index 0000000..462fff6
--- /dev/null
+++ b/services/controller/sandbox_macos.py
@@ -0,0 +1,51 @@
+"""macOS Seatbelt implementation of RAX's frozen-bundle execution boundary."""
+import json
+from pathlib import Path
+import shutil
+import sys
+
+from .sandbox import frame_path
+from .storage import project_directory
+from harness.agent_host import thread_variables
+
+
+def command(limits, bundle, mode, entrypoint, *, layout, writable, sdk, frames, workspace_path):
+    layout = Path(layout).resolve()
+    project = layout / project_directory(workspace_path)
+    shutil.copytree(bundle, project, dirs_exist_ok=True)
+    (layout / 'api/runtime.py').unlink()
+    shutil.copyfile(sdk, layout / 'api/runtime.py')
+    (layout / 'output').rmdir()
+    (layout / 'output').symlink_to(writable, target_is_directory=True)
+    if frames is not None:
+        destination = layout / frame_path(frames)
+        destination.rmdir()
+        destination.symlink_to(frames, target_is_directory=True)
+    q = lambda path: json.dumps(str(Path(path).resolve()))
+    readable = [layout, Path(writable), Path(sys.prefix), Path(sys.base_prefix)]
+    if frames is not None:
+        readable.append(Path(frames))
+    exceptions = ' '.join(f'(require-not (subpath {q(path)}))' for path in readable)
+    profile = layout.parent / 'sandbox.sb'
+    profile.write_text(f'''(version 1)
+(allow default)
+(deny network*)
+(deny mach-lookup)
+(deny process-fork)
+(deny process-exec (require-not (literal {q(sys.executable)})))
+(deny file-read* (require-all
+    (require-any (subpath {q(Path.home())}) (subpath "/private/tmp") (subpath "/tmp") (subpath "/private/var/folders"))
+    {exceptions}))
+(deny file-write* (require-all (require-not (subpath {q(writable)})) (require-not (subpath "/dev"))))
+''')
+    variables = {'HOME': str(layout), 'PATH': f'{sys.prefix}/bin:/usr/bin:/bin',
+                 'PYTHONPATH': f'{layout}:{project}', 'PYTHONDONTWRITEBYTECODE': '1',
+                 'PYTHONNOUSERSITE': '1', 'PIP_NO_INDEX': '1', 'HF_HUB_OFFLINE': '1',
+                 'WANDB_MODE': 'disabled', 'LANG': 'en_US.UTF-8', **thread_variables(limits.cpus)}
+    runtime = str(layout / 'api/runtime.py')
+    code = ('import os,runpy,sys;os.chdir(' + repr(str(layout)) + ');'
+            'os.environ.clear();os.environ.update(' + repr(variables) + ');'
+            'sys.path[:0]=' + repr([str(layout), str(project)]) + ';'
+            'sys.argv=' + repr([runtime, mode, str(project), entrypoint]) + ';'
+            'runpy.run_path(' + repr(runtime) + ',run_name="__main__")')
+    return ['/usr/bin/sandbox-exec', '-f', str(profile), sys.executable, '-I', '-u', '-c', code]
